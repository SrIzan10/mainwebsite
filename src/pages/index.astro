---
import BentoDiscord from '@/components/BentoDiscord'
import BentoGithub from '@/components/BentoGithub'
import BentoSpotify from '@/components/BentoSpotify'
import BentoWeather from '@/components/BentoWeather'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects, getRecentPosts } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const posts = await getRecentPosts(3)
const projects = await getAllProjects()

const tagline = 'I build, break, rebuild and (sometimes) write.'

const rowClass =
  'group hover:bg-secondary focus-visible:ring-ring -mx-3 flex items-baseline gap-4 rounded-lg px-3 py-3 transition-colors duration-700 ease-fluid focus-visible:ring-2 focus-visible:outline-none active:scale-[0.98]'
---

<Layout>
  <PageHead slot="head" title="Home" />

  <div class="mx-auto flex w-full max-w-[680px] flex-col gap-24 py-16">
    <!-- Hero -->
    <section class="flex flex-col items-start gap-6">
      <img
        data-reveal
        src="https://github.com/SrIzan10.png"
        alt="Izan's avatar"
        width="48"
        height="48"
        class="size-12 rounded-full border"
      />
      <h1
        data-reveal
        style="--reveal-delay: 100ms"
        class="bg-linear-to-r from-[#000000] to-[#666666] bg-clip-text pb-1 text-4xl font-semibold text-balance text-transparent sm:text-5xl dark:from-[#FFFFFF] dark:to-[#9B9B9B]"
      >
        Hi, I'm Izan. <br />
      </h1>
      <p
        data-reveal
        style="--reveal-delay: 200ms"
        class="text-muted-foreground text-lg text-pretty"
      >
        Student from Málaga, Spain. To cope with life, I sit down at the
        computer and build things.
      </p>
    </section>

    <!-- Projects -->
    <section data-reveal class="flex flex-col gap-4">
      <h2 class="text-muted-foreground text-sm font-semibold">Projects</h2>
      <ul class="flex flex-col">
        {
          projects.map((project) => (
            <li>
              <a
                href={project.data.link}
                target="_blank"
                rel="noopener"
                class={rowClass}
              >
                <span class="font-semibold">{project.data.name}</span>
                <span class="text-muted-foreground truncate text-sm">
                  {project.data.description}
                </span>
                <Icon
                  name="ph:arrow-up-right"
                  class="text-muted-foreground group-hover:text-foreground ml-auto size-4 shrink-0 self-center"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Tagline -->
    <p id="tagline" class="text-4xl font-semibold text-balance">
      {tagline.split(' ').map((word) => <span data-tagline-word>{word} </span>)}
    </p>

    <!-- Writing -->
    <section data-reveal class="flex flex-col gap-4">
      <div class="flex items-baseline justify-between">
        <h2 class="text-muted-foreground text-sm font-semibold">Writing</h2>
        <a
          href="/blog"
          class="text-muted-foreground hover:text-foreground ease-fluid text-sm transition-colors duration-700"
        >
          All posts
        </a>
      </div>
      <ul class="flex flex-col">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class={rowClass}>
                <span class="min-w-0 grow truncate font-semibold">
                  {post.data.title}
                </span>
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-muted-foreground shrink-0 font-mono text-xs"
                >
                  {formatDate(post.data.date)}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Right now -->
    <section data-reveal class="flex flex-col gap-4">
      <h2 class="text-muted-foreground text-sm font-semibold">Right now</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="min-h-40 overflow-hidden rounded-2xl border">
          <BentoSpotify client:visible />
        </div>
        <div class="min-h-40 overflow-hidden rounded-2xl border">
          <BentoDiscord client:visible />
        </div>
        <div class="min-h-40 overflow-hidden rounded-2xl border">
          <BentoWeather client:visible />
        </div>
        <div class="min-h-40 overflow-hidden rounded-2xl border">
          <BentoGithub client:visible />
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function init() {
    const reveal = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        entry.target.setAttribute('data-revealed', '')
        reveal.unobserve(entry.target)
      }
    })
    document
      .querySelectorAll('[data-reveal]')
      .forEach((el) => reveal.observe(el))

    // Light tagline words in reading order as it scrolls up the viewport.
    const tagline = document.getElementById('tagline')
    if (!tagline) return
    const words = tagline.querySelectorAll('[data-tagline-word]')
    let frame = 0
    const update = () => {
      frame = 0
      const { top, height } = tagline.getBoundingClientRect()
      const start = innerHeight * 0.85
      const end = innerHeight * 0.45 - height
      const progress = Math.min(1, Math.max(0, (start - top) / (start - end)))
      const lit = Math.round(progress * words.length)
      words.forEach((word, i) => word.toggleAttribute('data-lit', i < lit))
    }
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    update()

    document.addEventListener(
      'astro:before-swap',
      () => {
        reveal.disconnect()
        window.removeEventListener('scroll', onScroll)
      },
      { once: true },
    )
  }

  document.addEventListener('astro:page-load', init)
</script>
